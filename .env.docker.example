# Copy to .env.docker and fill in the values below.
# The @cloudflare/vite-plugin handles D1 / KV / R2 locally via miniflare —
# no external database or cache credentials are needed.

# ── Required ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=GvK6JqC/iC32oG1p4K89R3g2J3d4w5p1

# Base URL the app is served on inside Docker (keep this value as-is).
BETTER_AUTH_URL=http://localhost:8080

# ── Optional — OAuth Providers ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional — Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=

# ── Optional — Telegram Bot ──────────────────────────────────────────────────
TELEGRAM_API_KEY=
